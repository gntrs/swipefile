# Copy to .env and fill in. Restart `npm run dev` after changing VITE_ vars.
# An empty .env (or none at all) runs the app in demo mode on sample ads.
# Only the "Database" block is needed for your own swipe file; everything
# below it is optional and unlocks one feature each. Never commit your real .env.

# ------------------------------------------------------------------
# Database: Supabase project URL and keys (Project Settings, API). The
# VITE_ pair ships to the browser (public by design, row level security
# protects the data), so VITE_DB_ANON_KEY must be the anon or publishable
# key. The service key is for scripts only; never give it a VITE_ prefix.
VITE_DB_URL=
VITE_DB_ANON_KEY=
DB_SERVICE_KEY=
# Set to 1 to force demo mode even when the database values are set.
VITE_DEMO=
# Set to 1 to show sign up on the login page (default: accounts come from
# scripts/create-users.mjs). The setup check warns while it is on.
VITE_ALLOW_SIGNUP=

# ------------------------------------------------------------------
# Your brand and the app (optional but recommended)
# Your brand name exactly as it appears on your ads. The app uses it to tell
# your ads apart from rivals'.
VITE_OWN_BRAND=
# Same for the import scripts. Scripts fall back to VITE_OWN_BRAND when empty.
OWN_BRAND=
# Name shown as the app's wordmark (default Swipefile).
VITE_APP_NAME=
# Product name used in bot prompts and alerts sent by the scripts.
APP_NAME=
# Comma list of ISO country codes pinned first in pickers and Intel, e.g. ES,FR.
VITE_FOCUS_COUNTRIES=
# Which parts of the app are on. Default (empty): library,hooks,briefs,competitors,intel
# Add team (chat, goals, posts, outreach, availability) and ops (revenue,
# funnel, celebrations) to that list, or set all for everything. A list turns
# on exactly those modules plus library.
VITE_MODULES=
# Site funnel stages for the overview card, event:Label pairs in order.
# Default: landing_cta_clicked:Landing CTA,signup_started:Sign up started,signup_completed:Sign up done,user_registered:Registered,payment_initiated:Checkout started,payment_completed:Paid
VITE_FUNNEL_STAGES=

# ------------------------------------------------------------------
# Meta ads (optional: own-ad import + competitor ad library)
# scripts/import-meta-ads.mjs and scripts/import-ad-library.mjs
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Separate token for the public Ad Library API (falls back to META_ACCESS_TOKEN).
META_ADLIB_TOKEN=

# Keyword discovery, scripts/discover-winners.mjs.
# Comma list of search terms (or pass --terms="a,b").
DISCOVER_TERMS=
# Angle tags for imported ads, tag=regex;tag=regex, e.g. angle-ugc=ugc|creator;angle-offer=% off|discount
DISCOVER_ANGLES=

# ------------------------------------------------------------------
# Foreplay import (optional), scripts/import-foreplay.mjs
FOREPLAY_API_KEY=

# ------------------------------------------------------------------
# Creator finder (optional), scripts/scrape-creators.mjs. Needs BRAVE_API_KEY.
# Comma list of searches that find your creators, e.g.
# vegan recipes creator instagram,home workout coach instagram
CREATOR_QUERIES=
# Regex (case insensitive) a profile must match to be kept. Empty keeps all.
CREATOR_NICHE_RE=

# ------------------------------------------------------------------
# Telegram bot (optional: digests, alerts, chat listener)
# scripts/gm-listener.mjs, scripts/startup-radar.mjs, scripts/health-monitor.mjs
TG_BOT_TOKEN=
TG_CHAT_ID=

# ------------------------------------------------------------------
# Startup radar (optional), scripts/startup-radar.mjs daily news digest.
# Comma-separated lists; the radar exits with a hint if both are empty.
RADAR_TOPICS=
RADAR_WATCHLIST=
# Subreddits to scan (comma-separated, no r/ prefix).
RADAR_SUBREDDITS=
# IANA timezone for the once-a-day send key (default UTC).
RADAR_TZ=
# Claude CLI binary for the digest LLM pass (default: `claude` on PATH).
RADAR_CLAUDE_BIN=
# Optional extra sources for the radar:
BRAVE_API_KEY=
X_BEARER_TOKEN=

# ------------------------------------------------------------------
# PostHog analytics (optional: traffic pull + health monitor)
# scripts/posthog-pull.mjs, scripts/health-monitor.mjs
POSTHOG_API_KEY=
# Your PostHog project id: the number in your project's URL.
POSTHOG_PROJECT_ID=
# e.g. https://eu.posthog.com or https://us.posthog.com
POSTHOG_HOST=
# Funnel events for scripts/snapshot-kpis.mjs, comma list in order.
# Default: landing_cta_clicked,signup_started,signup_completed,user_registered,payment_initiated,payment_completed
FUNNEL_EVENTS=

# ------------------------------------------------------------------
# Health monitor (optional), scripts/health-monitor.mjs
# When running the monitor, all four below are required, plus
# POSTHOG_API_KEY and POSTHOG_PROJECT_ID from the PostHog block above.
HEALTH_ALERT_TO=
HEALTH_ALERT_FROM=
# Production endpoints to probe when something looks broken:
HEALTH_PROD_API=
HEALTH_PROD_WEB=
# Mailjet pair for the email channel:
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ------------------------------------------------------------------
# Stripe revenue (optional), scripts/stripe-pull.mjs, scripts/revenue-alert.mjs
STRIPE_API_KEY=
# IANA timezone used to bucket revenue by day (default UTC).
REVENUE_TZ=

# ------------------------------------------------------------------
# SEO rank tracking (optional), scripts/seo-rank-pull.mjs, scripts/trends-pull.mjs
# Your own domain, e.g. example.com (required by the SEO scripts).
SEO_OWN_DOMAIN=
# Comma-separated competitor domains to track alongside yours.
SEO_COMPETITOR_DOMAINS=
